# ============================================
# SurvyAI Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your actual values
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env

# ============================================
# REQUIRED: API Keys
# ============================================

# DeepSeek API Key
# Get your API key from: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ============================================
# Optional: DeepSeek Configuration
# ============================================

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ============================================
# Optional: Agent Configuration
# ============================================

# Primary LLM: "deepseek", "gemini", "openai", "claude"
PRIMARY_LLM=deepseek

# Fallback LLM if primary fails
FALLBACK_LLM=gemini

# LLM temperature (0.0-1.0)
AGENT_TEMPERATURE=0.3

# Maximum token budget per response
AGENT_MAX_TOKENS=200000

# Optional local runtime config JSON for prompt/model overrides
# If empty, SurvyAI uses agent/agent_config.json when present.
AGENT_CONFIG_PATH=

# ============================================
# Optional: ArcGIS Pro Integration
# ============================================

# Path to ArcGIS Pro Python environment (leave empty if not installed)
ARCGIS_PRO_PATH=C:\\Program Files\ArcGIS\Pro\bin\Python\envs\arcgispro-py3

# ============================================
# Optional: Blue Marble Geographic Calculator
# ============================================

BLUE_MARBLE_PATH=C:\\Program Files\\Blue Marble Geo\\Geographic Calculator

# ============================================
# Optional: Logging Configuration
# ============================================

LOG_LEVEL=INFO
LOG_FILE=survyai.log

# ============================================
# PostgreSQL – Vector Store + Cloud API database
# ============================================
# SurvyAI uses PostgreSQL with pgvector (ANN semantic search) and PostGIS
# (geospatial coordinate storage and proximity queries).
#
# For LOCAL DEVELOPMENT, start the bundled Docker stack:
#   docker compose up -d
# This starts postgres:16-postgis on localhost:5432 with the settings below.
#
# For PRODUCTION, point these at your managed PostgreSQL instance
# (must have vector, postgis, pg_trgm extensions).
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  SYNC vs ASYNC URLs (see survyai/database_urls.py)                      │
# ├──────────────────────┬──────────────────────────────────────────────────┤
# │ DATABASE_URL         │ Primary URL. Use SYNC form for clarity:          │
# │ (sync)               │   postgresql://user:pass@host:5432/dbname        │
# │                      │ Alembic migrations read this (or derived sync).  │
# ├──────────────────────┼──────────────────────────────────────────────────┤
# │ ASYNC_DATABASE_URL   │ FastAPI cloud API only (concurrent requests):    │
# │ (async)              │   postgresql+asyncpg://user:pass@host:5432/db  │
# │                      │ If omitted, derived from DATABASE_URL.           │
# ├──────────────────────┼──────────────────────────────────────────────────┤
# │ VECTOR_DB_URL        │ Desktop agent vector store (sync psycopg).       │
# │ (sync)               │ If empty, derived from DATABASE_URL.             │
# └──────────────────────┴──────────────────────────────────────────────────┘

# Sync — Alembic (`python -m alembic upgrade head`), admin scripts
DATABASE_URL=postgresql://survyai:survyai@localhost:5432/survyai

# Async — `python -m survyai_cloud` (FastAPI + SQLAlchemy async)
ASYNC_DATABASE_URL=postgresql+asyncpg://survyai:survyai@localhost:5432/survyai

# Sync — desktop semantic search / memory (`python -m survyai.gui`)
VECTOR_DB_URL=postgresql://survyai:survyai@localhost:5432/survyai

# ============================================
# Vector Store / Embeddings Configuration
# ============================================

# Enable semantic search and memory
VECTOR_STORE_ENABLED=True

# Embedding provider: "local" (offline, free) or "openai" (higher quality)
EMBEDDING_PROVIDER=local

# Local model for embeddings (384-dim; fast, no internet needed after download)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# OpenAI embedding model (1536-dim; requires OPENAI_API_KEY)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector column dimension – must match your embedding model.
# Change before first migration.  Default matches OpenAI (1536) and
# can also store local 384-dim vectors padded to 1536.
# For all-MiniLM-L6-v2 only deployments, set to 384 and re-migrate.
VECTOR_EMBEDDING_DIM=1536

# Search mode: "hybrid" (recommended), "semantic", or "keyword"
# hybrid: cosine ANN + BM25/ts_rank fused with Reciprocal Rank Fusion (RRF)
# semantic: pure vector cosine similarity
# keyword: full-text search only (no embedding call at query time)
VECTOR_SEARCH_MODE=hybrid

# Semantic vs keyword balance in hybrid mode (0.0=keyword only, 1.0=semantic only)
VECTOR_HYBRID_ALPHA=0.6

# HNSW index tuning (applied at migration time; change → re-migrate)
VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCTION=64

# ============================================
# Context Retrieval Settings
# ============================================

# Automatically retrieve relevant context from past conversations/documents
AUTO_CONTEXT_RETRIEVAL=True

# Number of relevant context items to retrieve
CONTEXT_RETRIEVAL_TOP_K=5

# Automatically store conversations for future context
AUTO_STORE_CONVERSATIONS=True

# Minimum similarity score (0-1) for context to be included
CONTEXT_SCORE_THRESHOLD=0.3

# ============================================
# SurvyAI Desktop / Commercial
# ============================================

# Optional: cloud auth for packaged Windows app
# SURVYAI_ACCESS_TOKEN=
# SURVYAI_API_BASE_URL=https://api.example.com
# SURVYAI_LLM_PROXY_ENABLED=1
# SURVYAI_LLM_PROXY_PATH=/v1/llm/chat
# SURVYAI_DEVICE_ID=<uuid-from-cloud-device-registration>

# License: builder = full tools for dev (default). pro = commercial.
# SURVYAI_LICENSE_MODE=builder
# SURVYAI_LICENSE_MODE=pro
# SURVYAI_FEATURE_AUTOCAD=1
# SURVYAI_FEATURE_ARCGIS=1
# SURVYAI_FEATURE_BLUE_MARBLE=1
# SURVYAI_FEATURE_INTERNET=1
# SURVYAI_FEATURE_VECTOR_STORE=1

# ============================================
# Optional: plan policy enforcement (commercial; default OFF for dev)
# ============================================

# ENFORCE_PLAN_POLICIES=false
# FREE_PLAN_CAD_SUCCESS_30D_CAP=10
# PRO_PLAN_CAD_SUCCESS_30D_CAP=100
# PRO_PLAN_CAD_SUCCESS_365D_CAP=1300

# ============================================
# Credits: NGN→USD conversion and user-facing cost markup (cloud backend)
# ============================================

# Exchange rate used to convert the Naira subscription amount to a USD credit balance.
# Update periodically to match market rates (default ≈ ₦1,600/$1).
# NGN_TO_USD_RATE=0.00062

# Multiplier applied to raw LLM API cost before displaying to the user.
# Covers infrastructure, overhead, and margin (default 2×).
# CREDIT_MARKUP_MULTIPLIER=2

# ============================================
# SurvyAI Cloud API — Paystack (Pro subscriptions)
# ============================================
# Loaded by ``python -m survyai_cloud`` from .env and/or .env.cloud (server-only).
# Desktop "Subscribe to Pro" calls this API; running the server alone is not enough
# without these keys. Check http://127.0.0.1:8088/health for paystack_*_configured flags.
#
# Production hardening:
# SURVYAI_ENV=production
# JWT_SECRET=<32+ random chars>
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# CORS_ORIGINS=https://app.example.com
# DATABASE_URL / ASYNC_DATABASE_URL must point to PostgreSQL (SQLite is rejected)

# Transactional email (password reset via Resend):
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=SurvyAI <noreply@yourdomain.com>
# PASSWORD_RESET_TTL_MINUTES=30

# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
# Plan *codes* from Paystack Dashboard → Plans (PLN_…), not Naira amounts:
# PAYSTACK_PLAN_CODE_PRO_DAILY=PLN_xxxxxxxx
# PAYSTACK_PLAN_CODE_PRO_WEEKLY=PLN_xxxxxxxx
# PAYSTACK_PLAN_CODE_PRO_MONTHLY=PLN_xxxxxxxx
# PAYSTACK_PLAN_CODE_PRO_ANNUAL=PLN_xxxxxxxx
# PAYSTACK_PRO_DAILY_AMOUNT_NGN=1000
# PAYSTACK_PRO_WEEKLY_AMOUNT_NGN=5000
# PAYSTACK_PRO_MONTHLY_AMOUNT_NGN=15000
# PAYSTACK_PRO_ANNUAL_AMOUNT_NGN=162000
# PAYSTACK_CALLBACK_URL=http://127.0.0.1/survyai/paystack/callback
