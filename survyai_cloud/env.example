# Copy to .env.cloud (recommended) or extend .env — cloud API only.

# Core
DATABASE_URL=sqlite+aiosqlite:///./data/survyai_cloud.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/survyai_cloud
# Postgres: schema changes via Alembic (see repo alembic/). On startup, upgrade runs by default.
RUN_MIGRATIONS_ON_STARTUP=1
JWT_SECRET=generate-with-openssl-rand-hex-32
# Desktop access token lifetime (minutes). Default 7200 = 120 hours. Max 10080 = 7 days.
# ACCESS_TOKEN_EXPIRE_MINUTES=7200
DEBUG=0

# Redis (recommended in production for multi-worker rate limits)
REDIS_URL=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BOOTSTRAP_PER_WINDOW=30
RATE_LIMIT_USAGE_EVENTS_PER_WINDOW=240

# CORS (comma-separated; use * only in dev)
CORS_ORIGINS=*

# Paystack (Nigeria-first)
# 1) In https://dashboard.paystack.com → Plans → Create plan (currency NGN):
#    - Monthly: amount ₦15,000, interval monthly → copy Plan code (PLN_…)
#    - Yearly: amount ₦162,000, interval annually → copy Plan code (PLN_…)
# 2) Paste those codes below. Amounts shown in the app default to ₦15k / ₦162k; override if needed:
#    PAYSTACK_PRO_MONTHLY_AMOUNT_NGN=15000
#    PAYSTACK_PRO_ANNUAL_AMOUNT_NGN=162000
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_CODE_PRO_MONTHLY=
PAYSTACK_PLAN_CODE_PRO_ANNUAL=
PAYSTACK_CALLBACK_URL=https://yourapp.example/paystack/callback
PAYSTACK_WEBHOOK_ENABLED=1

# Platform LLM keys (served only to active Pro desktops via GET /v1/bootstrap)
PLATFORM_PRIMARY_LLM=openai
PLATFORM_OPENAI_API_KEY=
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_GOOGLE_API_KEY=
PLATFORM_DEEPSEEK_API_KEY=
PLATFORM_OPENAI_MODEL=gpt-4o-mini
PLATFORM_OPENAI_MODEL_NANO=gpt-5-nano
PLATFORM_OPENAI_MODEL_MINI=gpt-5-mini
PLATFORM_OPENAI_MODEL_COMPLEX=gpt-5.1
PLATFORM_ENABLE_TIERED_MODELS=1
PLATFORM_GEMINI_MODEL=gemini-2.0-flash
PLATFORM_CLAUDE_MODEL=claude-3-5-sonnet-20241022
PLATFORM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Updates (optional JSON file path for GET /v1/updates/manifest)
UPDATES_MANIFEST_PATH=
DIAGNOSTICS_STORAGE_DIR=./data/diagnostics_uploads
